@protokol = http:
@adresa = localhost
@port = 7080

### concatenate with Hello get request
GET {{protokol}}//{{adresa}}:{{port}}/sample?name=Мића HTTP/1.1
content-type: application/json


### show value field post request
POST {{protokol}}//{{adresa}}:{{port}}/test HTTP/1.1
content-type: application/json

{
    "ime": "Pera",
    "prezime": "Peric",
    "value": "Miki"
}

### mnozenje
GET {{protokol}}//{{adresa}}:{{port}}/pomnozi?arg1=2&arg2=3&arg3=4 HTTP/1.1
content-type: application/json

### mnozenje
GET {{protokol}}//{{adresa}}:{{port}}/pomnozi?arg1=2&arg2=3 HTTP/1.1
content-type: application/json

### mnozenje
GET {{protokol}}//{{adresa}}:{{port}}/pomnozi?arg1=2 HTTP/1.1
content-type: application/json


### mnozenje
GET {{protokol}}//{{adresa}}:{{port}}/pomnozi?arg1="MiKi" HTTP/1.1
content-type: application/json

